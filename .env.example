# Copy to .env:  cp .env.example .env

# OpenRouter API key (required) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Per-agent model overrides (optional; defaults in config/constants.py).
# Can also be changed at runtime from the Streamlit sidebar.
TRIAGE_MODEL=meta-llama/llama-4-scout
RESOLVER_MODEL=meta-llama/llama-4-scout

# TEST AID for AI_DAT_SEC_011: write LLM inputs/outputs to logs/llm_io.jsonl (contains PII!)
LLM_IO_LOG=false

LOG_LEVEL=INFO
GR_SERVICE_URL=https://mcp.v2.prod.veedna.com/enforce
LINEAJE_REFRESH_
